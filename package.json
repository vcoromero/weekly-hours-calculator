{
  "name": "weekly-hours-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=dev --projects=frontend,backend --parallel",
    "build": "nx run-many --target=build --projects=frontend,backend",
    "lint": "nx run-many --target=lint --projects=frontend,backend",
    "test": "nx run-many --target=test --projects=frontend,backend",
    "db:migrate": "nx run backend:db:migrate",
    "db:generate": "nx run backend:db:generate",
    "db:seed": "nx run backend:db:seed",
    "db:backfill-day-saved-at": "nx run backend:db:backfill-day-saved-at",
    "db:studio": "nx run backend:db:studio",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "nx": "^23.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
