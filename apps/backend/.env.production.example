# =============================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================
# Copy this file to apps/backend/.env.production and fill in the values.
# DO NOT commit apps/backend/.env.production to git!

# --- Backend (Render) ---

PORT=3000
NODE_ENV=production

DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/weekly-hours"

JWT_SECRET="generate-a-new-64-char-base64-string"
JWT_EXPIRES_IN="7d"

MASTER_EMAIL="samygmar@gmail.com"
MASTER_PASSWORD_HASH="$2a$10$..."

FRONTEND_URL="https://weekly-hours-tracker.netlify.app"

