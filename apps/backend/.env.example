# =============================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================
# This file is consumed by dotenv from apps/backend/src/config/env.ts.
# Copy this file to apps/backend/.env and fill in the values.
# The .env file is gitignored — it persists on disk across branch switches.

# --- Server ---
# PORT is the Express server port (default: 3000).
PORT=3000

# NODE_ENV controls logging verbosity and error detail.
# Use "development" locally, "production" on Render.
NODE_ENV=development

# --- Database ---
# DATABASE_URL is the Prisma connection string for PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# The USER, PASSWORD, and DB_NAME must match the values in your root .env (Docker Compose).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weekly_hours_tracker?schema=public"

# --- Authentication ---
# JWT_SECRET is used to sign and verify JWT tokens.
# Generate a strong random string (at least 32 characters).
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string"

# JWT_EXPIRES_IN is the token lifetime. Accepts vercel/ms format (e.g. "7d", "24h").
JWT_EXPIRES_IN="7d"

# MASTER_EMAIL is the login email for the single master user.
# This is a credential — do not commit real values to git.
MASTER_EMAIL="admin@example.com"

# MASTER_PASSWORD_HASH is a bcrypt hash of the master user's password.
# Generate one with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
MASTER_PASSWORD_HASH="change-me-to-a-bcrypt-hash"

# --- Frontend ---
# FRONTEND_URL is the origin of the Vite dev server or production frontend.
# Used by CORS and any redirects that point back to the client.
FRONTEND_URL="http://localhost:5173"

# =============================================
# IMPORTANT: QUOTING FOR $ CHARACTERS
# =============================================
# Bcrypt hashes contain $ characters (e.g. $2a$10$...).
# Values with $ MUST be wrapped in double quotes in .env files.
# Without quotes, dotenv treats $ as variable interpolation and
# SILENTLY TRUNCATES the value — the hash becomes too short and
# login will fail with a cryptic bcrypt error.
#
# WRONG (dotenv strips "$ZrA2mj..." as a variable reference):
#   MASTER_PASSWORD_HASH=$2a$10$ZrA2mjF8e8nhxLnGQt7Ls.4t9yu.17iXJqLv3oedU1Fsf6TNXQohG
#
# RIGHT (quoting preserves the full 60-char hash):
#   MASTER_PASSWORD_HASH="$2a$10$ZrA2mjF8e8nhxLnGQt7Ls.4t9yu.17iXJqLv3oedU1Fsf6TNXQohG"
#
# The same rule applies to DATABASE_URL if your password contains $.

# =============================================
# IMPORTANT: tsx watch DOES NOT RELOAD .env
# =============================================
# The backend dev server (tsx watch) only restarts on .ts file changes.
# If you edit this .env file, the running process will NOT pick up the
# new values. You must manually restart the server:
#   1. Press Ctrl+C to stop the current process.
#   2. Re-run: npm run dev
