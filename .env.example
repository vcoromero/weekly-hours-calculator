# =============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# =============================================
# This file is consumed by docker-compose.yml to create the local PostgreSQL container.
# Copy this file to .env in the project root and adjust values if needed.
# The .env file is gitignored — it persists on disk across branch switches.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weekly_hours_tracker
